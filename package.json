{
  "name": "kintrace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "test:prod": "playwright test --project=chromium builder.smoke.spec.ts findings.spec.ts report.spec.ts edge/privacy.spec.ts --grep-invert \"build contains no API keys\"",
    "verify": "node scripts/verify/index.mjs",
    "verify:final": "node scripts/verify/index.mjs --final",
    "test:all": "npm run verify",
    "smoke": "node scripts/smoke.mjs",
    "check:providers": "vitest run --config vitest.live.config.ts",
    "eval:parser": "vitest run --config vitest.eval.config.ts",
    "test:mutation": "stryker run && node scripts/mutation-score.mjs",
    "onepager": "node scripts/onepager.mjs",
    "screenshots": "playwright test --config playwright.screenshots.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
