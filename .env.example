# Copy to .env (never commit .env). Read only by the optional serverless
# parser in api/parse.ts. The browser bundle never sees these.

# NVIDIA hosted API key, from build.nvidia.com. Without it, Quick add uses the offline parser.
NVIDIA_API_KEY=replace-with-your-nvidia-api-key
# Model id from NVIDIA's catalogue. Optional; the default is in api/_lib/config.ts.
PARSER_MODEL=
# Providers to try, in order, separated by commas. Optional; default nvidia.
PARSER_PROVIDERS=
# Most model calls per provider per day, per instance. Optional; default 300.
PARSER_DAILY_CAP=
